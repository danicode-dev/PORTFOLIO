---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<header class="section-heading" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 {id}>{title}</h2>
  {description && <p class="section-heading__description">{description}</p>}
</header>
